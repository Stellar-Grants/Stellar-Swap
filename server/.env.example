# Server port (default: 8000)
PORT=8000

# Allowed CORS origin — set to your frontend URL in production
# Example: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000

# Stellar network to connect to: "testnet" or "mainnet"
# Default: testnet
STELLAR_NETWORK=testnet

# Horizon REST API URL for Classic Stellar operations — leave blank to use the default
# Testnet default: https://horizon-testnet.stellar.org
# Mainnet default: https://horizon.stellar.org
HORIZON_URL=

# Retry settings for txBAD_SEQ sequence-number conflicts (concurrent requests
# for the same account). See server/utils/stellarTx.js.
# Max number of retries after the initial attempt (default: 3)
TX_MAX_RETRIES=3
# Base delay in ms for exponential backoff between retries (default: 200)
TX_RETRY_DELAY_MS=200
